# Copy to .env is NOT automatic: export these in your shell or set them in your process manager.
# For a real server use .env.production.example instead.
PORT=8080
NODE_ENV=development
DB_PATH=./data/platform.db

# Real accounts (email + password) are always on. In development the email codes are printed to the
# server log instead of being sent, and email confirmation is optional.
JWT_SECRET=dev-only-change-me-dev-only-change-me
# REQUIRE_EMAIL_VERIFICATION=true     # try the production behaviour locally

# Shortcut for tests and demos: POST /v1/dev/login without a password. Never in production.
ALLOW_DEV_LOGIN=false

# Random 32+ character secrets (required when NODE_ENV=production).
PLATFORM_SERVICE_KEY=dev-service-key-change-me
PLATFORM_DOWNLOAD_KEY=dev-download-key-change-me

# Where published builds live, and the public address used in download links behind a proxy.
DEPOT_DIR=./data/depot
# PUBLIC_BASE_URL=https://api.example.com

# Comma separated browser origins allowed to call the API (the launcher dev server).
CORS_ORIGINS=http://localhost:1420
