{
  "name": "one-engine-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:1420 && electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.cjs\"",
    "predist": "node scripts/write-app-config.cjs",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/titan-one": "^5.3.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wait-on": "^9.5.1"
  },
  "description": "OneEngine Store: desktop launcher for OneEngine games",
  "author": "OneEngine <oneenginedev@gmail.com>",
  "build": {
    "appId": "dev.oneengine.store",
    "productName": "OneEngine Store",
    "copyright": "OneEngine",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/images/logo.png",
      "artifactName": "OneEngine-Store-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "OneEngine Store",
      "uninstallDisplayName": "OneEngine Store",
      "deleteAppDataOnUninstall": false
    }
  }
}
